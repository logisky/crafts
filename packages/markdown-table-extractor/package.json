    "label": {
        "en": "Markdown Table Extractor",
        "zh-CN": "Markdown 表格提取"
    },
    "description": "Parse GitHub-flavored Markdown tables into structured JSON (UMD bundle)",
    "main": "dist/markdown-table-extractor.js",
    "module": "dist/markdown-table-extractor.js",
